# Android emulator → host machine
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# iOS simulator / web on same machine:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical device on same Wi‑Fi: use your PC LAN IP, e.g. http://192.168.1.x:8000

# SignalR (disabled until BE hub is available)
EXPO_PUBLIC_SIGNALR_HUB_URL=http://10.0.2.2:8000/hubs/hakeem
EXPO_PUBLIC_SIGNALR_ENABLED=false

EXPO_PUBLIC_USE_MOCK_AUTH=false

# Google Sign-In — Web Client ID must match BE Authentication:Google:ClientId
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional platform-specific OAuth clients (fallback to web client id if unset)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
